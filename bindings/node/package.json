{
  "name": "@neptro/fstx",
  "version": "0.1.0",
  "description": "Atomic, crash-safe multi-file transactions for Node.js: change many files all-or-nothing, with rollback and crash recovery.",
  "keywords": ["atomic", "transaction", "filesystem", "crash-safe", "rollback", "fsync", "write-file-atomic", "fs"],
  "license": "MIT OR Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/neptro/fstx.git", "directory": "bindings/node" },
  "homepage": "https://github.com/neptro/fstx/tree/main/bindings/node#readme",
  "main": "index.js",
  "types": "index.d.ts",
  "files": ["index.js", "index.d.ts", "binding.js", "binding.d.ts", "*.node"],
  "os": ["linux"],
  "engines": { "node": ">= 20" },
  "napi": {
    "binaryName": "fstx",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts",
    "test": "node --test __test__/*.test.mjs && tsc -p __test__",
    "prepublishOnly": "node -e \"const n=require('fs').readdirSync('.').filter(f=>f.endsWith('.node'));if(n.length<1)throw new Error('no .node binaries; run npm run build');console.log('binaries:',n)\""
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
